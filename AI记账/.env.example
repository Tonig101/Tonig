# ===== 大模型对话（/api/chat 用，OpenAI 兼容接口）=====
# 接口地址，默认 OpenAI；换成兼容端点（如本地 vLLM、Azure、第三方）也可
LLM_BASE_URL=https://api.openai.com/v1
# 必填：没有它，对话会回退到前端本地逻辑
LLM_API_KEY=
# 模型名，按需修改
LLM_MODEL=gpt-4o-mini
# 请求超时（秒）
LLM_TIMEOUT=30

# ===== 腾讯云 OCR（/api/ocr 用，服务端签名，密钥不进浏览器）=====
# 在 https://console.cloud.tencent.com/cam/capi 获取
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 地域，默认广州
TENCENT_REGION=ap-guangzhou

# ===== 截图识别方式（可选）=====
# auto（默认）：有腾讯云密钥走腾讯云，否则自动退回到"视觉大模型识别"
# tencent：强制只用腾讯云；vision：强制只用视觉大模型
# 视觉大模型识别会复用上面的 LLM_API_KEY / LLM_MODEL，
# 因此只要聊天能配通，截图识别就能用，无需再申请腾讯云账号
# （注意：LLM_MODEL 必须是支持图片的视觉模型，如 gpt-4o-mini）
OCR_METHOD=auto

# ===== 服务端口 =====
PORT=8000

# ===== 省钱雷达 API（deals_api.py，可选）=====
# 服务端口（默认 8010）
DEALS_API_PORT=8010

# 实时价格接口（可选）。不配就不抓任何电商页面，只做比价口径计算。
# 支持 {item} 占位符，例如：https://api.example.com/search?q={item}
PRICE_API_URL=
PRICE_API_KEY=
# 字段映射：list 指向数据数组（支持点号取嵌套）
PRICE_FIELD_MAP={"list":"data.items","platform":"mall","title":"name","price":"price","spec":"spec","ship":"freight","coupon":"coupon"}
